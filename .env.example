# .env.example — same Auth0 tenant as GlobalPartnerPortal
# Copy this file to .env.local and fill in your values

AUTH0_SECRET='use [openssl rand -hex 32] to generate a 32 bytes value'
AUTH0_BASE_URL='http://localhost:3001'
AUTH0_ISSUER_BASE_URL='https://YOUR_AUTH0_TENANT.us.auth0.com'

# A/B/C Testing — three Regular Web App registrations in the SAME Auth0 tenant
# Each needs its own Allowed Callback URL:
#   A: http://localhost:3001/api/auth/callback
#   B: http://localhost:3001/api/auth-b/callback
#   C: http://localhost:3001/api/auth-c/callback

AUTH0_CLIENT_ID_A='YOUR_MOBILITY_CLIENT_ID_A'
AUTH0_CLIENT_SECRET_A='YOUR_MOBILITY_CLIENT_SECRET_A'

AUTH0_CLIENT_ID_B='YOUR_MOBILITY_CLIENT_ID_B'
AUTH0_CLIENT_SECRET_B='YOUR_MOBILITY_CLIENT_SECRET_B'

AUTH0_CLIENT_ID_C='YOUR_MOBILITY_CLIENT_ID_C'
AUTH0_CLIENT_SECRET_C='YOUR_MOBILITY_CLIENT_SECRET_C'

# Auth0 My Account API — required for passkey enrollment and authentication methods
# AUTH0_MANAGEMENT_DOMAIN must be the native Auth0 tenant domain (e.g. your-tenant.us.auth0.com)
# NOT a custom domain — the /me/v1/ and /passkey/challenge endpoints only work on native domains
AUTH0_MANAGEMENT_DOMAIN='your-tenant.us.auth0.com'

# M2M application credentials for Auth0 Management API (enterprise connections, etc.)
AUTH0_MANAGEMENT_CLIENT_ID='YOUR_M2M_CLIENT_ID'
AUTH0_MANAGEMENT_CLIENT_SECRET='YOUR_M2M_CLIENT_SECRET'

# Auth0 My Account API audience — used when requesting access tokens scoped to /me/v1/
A0_MYACCOUNT_API_AUDIENCE='https://your-tenant.us.auth0.com/me'

# Cross-portal link — URL of GlobalPartnerPortal (for SSO nav link)
NEXT_PUBLIC_PARTNER_PORTAL_URL=http://localhost:3000
